# Токен из MAX для бизнеса → Чат-боты → Расширенные настройки
MAX_BOT_TOKEN=replace_me

# Ваш MAX user_id. Сначала запустите бота и отправьте /id.
OWNER_USER_ID=123456789

TIMEZONE=Europe/Moscow
CLASSES=8МК,2Б
PROMPT_TIME=15:00
REMINDER_TIME=16:30
DEADLINE_TIME=17:00
SCHOOL_DAYS_ONLY=true
DATABASE_URL=sqlite+aiosqlite:////app/data/bot.db

# Без WEBHOOK_URL бот запускается в Long Polling (только разработка/проверка).
# Для production укажите полный публичный HTTPS URL и секрет.
# WEBHOOK_URL=https://bot.example.ru/webhook
# WEBHOOK_SECRET=replace_with_random_secret

# Включите один раз, если переходите с Webhook на Long Polling.
POLLING_DELETE_WEBHOOKS=false
BOT_PORT=8080

# Только для compose.webhook.yaml
# BOT_DOMAIN=bot.example.ru

